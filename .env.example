# Copier en .env pour le développement local. Ne jamais committer le fichier .env.
# Utiliser exclusivement des clés de TEST (sk_test_..., whsec_... du mode test).

PORT=3000

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Firebase Admin (compte de service ; FIREBASE_PRIVATE_KEY avec les \n échappés)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe (mode test)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Frontend et CORS
FRONTEND_URL=https://adminfacile-app.netlify.app
# Liste séparée par des virgules ; valeur par défaut = origines historiques du projet
CORS_ORIGINS=

# Quotas et limites
FREE_LETTER_LIMIT=3
# Messages gratuits par jour pour l'assistant et le chat document (heure de Paris)
FREE_CHAT_DAILY_LIMIT=5
MAX_UPLOAD_MB=8
# Durée maximale de lecture d'une image (OCR), en secondes
OCR_TIMEOUT_SECONDS=30
