PORT=3000
HOST=0.0.0.0
NODE_ENV=development
TRUST_PROXY_HOPS=0
PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
FIREBASE_PROJECT_ID=adminfacile
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=adminfacile.firebaseapp.com
PUBLIC_FIREBASE_APP_ID=
REQUIRE_VERIFIED_EMAIL=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Alternative au triplet Firebase : chemin absolu d’un JSON privé hors dossier public.
GOOGLE_APPLICATION_CREDENTIALS=
# Alternative hébergement : JSON complet dans une variable secrète.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Stripe reste fermé tant que mode, prix, webhook et activation ne sont pas validés.
STRIPE_MODE=disabled
STRIPE_TEST_SECRET_KEY=
STRIPE_CHECKOUT_ENABLED=false
STRIPE_PRICE_LABEL=
STRIPE_PORTAL_CONFIGURATION_ID=
