{
  "name": "adminfacile",
  "version": "2.0.0",
  "description": "Assistant administratif intelligent",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "demo": "DEMO_MODE=true node server.js",
    "test": "node --test tests/*.test.js",
    "check": "node --check server.js && node --check backend/app.js && node --check frontend/js/app.js",
    "build": "node scripts/build-frontend.js",
    "format": "prettier --write app.html index.html dashboard.html dashboard_v2.html server.js backend/*.js frontend/js/*.js frontend/css/*.css tests/*.js scripts/*.js",
    "services:check": "node scripts/check-services.js",
    "services:firebase": "node scripts/configure-firebase.js",
    "test:live": "node scripts/smoke-live.js"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "docx": "^9.6.1",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "file-saver": "^2.0.5",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "openai": "^4.56.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.20.2",
    "stripe": "^22.1.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22"
  }
}
