    "file-saver": "^2.0.5",
    "firebase-admin": "^13.9.0",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "openai": "^4.56.0",
    "pdf-parse": "^1.1.1",
    "stripe": "^22.1.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.27.0",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=20"
